<Window x:Class="HiResAudioPlayerTagMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:skiasharp="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:models="clr-namespace:HiResAudioPlayerTagMaster.Models"
        xmlns:services="clr-namespace:HiResAudioPlayerTagMaster.Services"
        xmlns:converters="clr-namespace:HiResAudioPlayerTagMaster.Converters"
        mc:Ignorable="d"
        Title="Hi-Res Audio Player &amp; Tag Master Pro" 
        Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="#05070A"
        Foreground="#F8FAFC">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Real-Time Spectrum Visualizer -->
            <RowDefinition Height="220"/>
            <!-- 2: Equalizer Collapsible Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Main Workspace (Library, Track Grid, Tag Editor) -->
            <RowDefinition Height="*"/>
            <!-- 4: Bottom Playback Dock -->
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: HEADER BAR ==================== -->
        <Border Grid.Row="0" Background="#0C0F17" BorderBrush="#202738" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Title & Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F59E0B" CornerRadius="6" Width="32" Height="32" Margin="0,0,12,0">
                        <TextBlock Text="🎵" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#05070A"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="HI-RES AUDIO PLAYER &amp; TAG MASTER PRO" FontSize="14" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock Text="BIT-PERFECT WASAPI / ASIO ENGINE • 60 FPS SKIASHARP VISUALIZER • TAGLIB SHARP" FontSize="9" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Audio Format Badge & WASAPI Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="12" Padding="12,5" Margin="0,0,10,0" BorderBrush="#F59E0B" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding CurrentTrack.CodecFormat, FallbackValue='FLAC 24-bit / 192.0kHz (9216 kbps)'}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#064E3B" CornerRadius="12" Padding="10,5" BorderBrush="#10B981" BorderThickness="1">
                        <TextBlock Text="{Binding SelectedOutputDevice.Name, FallbackValue='WASAPI Exclusive Bit-Perfect'}" 
                                   FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                    </Border>
                </StackPanel>

                <!-- Audio Output Device Selector -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Output Device:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding OutputDevices}" 
                              SelectedItem="{Binding SelectedOutputDevice}"
                              Width="280" Height="30" DisplayMemberPath="Name"
                              Background="#141924" Foreground="#F8FAFC" BorderBrush="#202738"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ROW 1: SKIASHARP VISUALIZER ==================== -->
        <Border Grid.Row="1" Background="#05070A" BorderBrush="#202738" BorderThickness="0,0,0,1">
            <Grid>
                <!-- SkiaSharp Canvas -->
                <skiasharp:SKElement x:Name="SkiaCanvas" PaintSurface="OnSkiaCanvasPaintSurface"/>

                <!-- Visualizer Controls & Overlay Buttons -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Orientation="Horizontal">
                    <RadioButton Content="Spectrum Bars" IsChecked="True" 
                                 Command="{Binding SelectVisualizerModeCommand}" CommandParameter="{x:Static services:VisualizerMode.SpectrumBars}"
                                 Foreground="#F8FAFC" Margin="0,0,10,0"/>
                    <RadioButton Content="Oscilloscope" 
                                 Command="{Binding SelectVisualizerModeCommand}" CommandParameter="{x:Static services:VisualizerMode.Oscilloscope}"
                                 Foreground="#F8FAFC" Margin="0,0,10,0"/>
                    <RadioButton Content="Stereo VU Meter" 
                                 Command="{Binding SelectVisualizerModeCommand}" CommandParameter="{x:Static services:VisualizerMode.StereoVuMeter}"
                                 Foreground="#F8FAFC"/>
                </StackPanel>

                <TextBlock Text="60 FPS FFT AUDIO SPECTRUM ANALYZER" FontSize="9" FontWeight="Bold" Foreground="#475569" 
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,12,0,0"/>
            </Grid>
        </Border>

        <!-- ==================== ROW 2: EQUALIZER OVERLAY ==================== -->
        <Border Grid.Row="2" Background="#0C0F17" BorderBrush="#202738" BorderThickness="0,0,0,1" Padding="16,10"
                Visibility="{Binding IsEqualizerOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="🎚️ 10-BAND GRAPHIC EQUALIZER &amp; DSP PREAMP" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="Preset:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding EqualizerPresets}" DisplayMemberPath="Name" 
                              SelectedItem="{Binding SelectedEqualizerPreset}" Width="180" Height="26"/>
                </StackPanel>

                <!-- 10 Sliders -->
                <UniformGrid Grid.Row="1" Columns="10" Height="100">
                    <!-- Band 0: 31Hz -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding EqBand0, StringFormat={}{0:F1}dB}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <Slider Orientation="Vertical" Height="65" Minimum="-12" Maximum="12" Value="{Binding EqBand0}" TickFrequency="1" IsSnapToTickEnabled="False"/>
                        <TextBlock Text="31Hz" FontSize="9" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- Band 1: 62Hz -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding EqBand1, StringFormat={}{0:F1}dB}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <Slider Orientation="Vertical" Height="65" Minimum="-12" Maximum="12" Value="{Binding EqBand1}"/>
                        <TextBlock Text="62Hz" FontSize="9" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- Band 2: 125Hz -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding EqBand2, StringFormat={}{0:F1}dB}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <Slider Orientation="Vertical" Height="65" Minimum="-12" Maximum="12" Value="{Binding EqBand2}"/>
                        <TextBlock Text="125Hz" FontSize="9" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- Band 3: 250Hz -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding EqBand3, StringFormat={}{0:F1}dB}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <Slider Orientation="Vertical" Height="65" Minimum="-12" Maximum="12" Value="{Binding EqBand3}"/>
                        <TextBlock Text="250Hz" FontSize="9" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- Band 4: 500Hz -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding EqBand4, StringFormat={}{0:F1}dB}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <Slider Orientation="Vertical" Height="65" Minimum="-12" Maximum="12" Value="{Binding EqBand4}"/>
                        <TextBlock Text="500Hz" FontSize="9" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- Band 5: 1kHz -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding EqBand5, StringFormat={}{0:F1}dB}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <Slider Orientation="Vertical" Height="65" Minimum="-12" Maximum="12" Value="{Binding EqBand5}"/>
                        <TextBlock Text="1kHz" FontSize="9" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- Band 6: 2kHz -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding EqBand6, StringFormat={}{0:F1}dB}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <Slider Orientation="Vertical" Height="65" Minimum="-12" Maximum="12" Value="{Binding EqBand6}"/>
                        <TextBlock Text="2kHz" FontSize="9" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- Band 7: 4kHz -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding EqBand7, StringFormat={}{0:F1}dB}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <Slider Orientation="Vertical" Height="65" Minimum="-12" Maximum="12" Value="{Binding EqBand7}"/>
                        <TextBlock Text="4kHz" FontSize="9" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- Band 8: 8kHz -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding EqBand8, StringFormat={}{0:F1}dB}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <Slider Orientation="Vertical" Height="65" Minimum="-12" Maximum="12" Value="{Binding EqBand8}"/>
                        <TextBlock Text="8kHz" FontSize="9" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- Band 9: 16kHz -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding EqBand9, StringFormat={}{0:F1}dB}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <Slider Orientation="Vertical" Height="65" Minimum="-12" Maximum="12" Value="{Binding EqBand9}"/>
                        <TextBlock Text="16kHz" FontSize="9" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ==================== ROW 3: MAIN WORKSPACE ==================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Left Library & Playlist Sidebar -->
                <ColumnDefinition Width="260"/>
                <!-- Column 1: Center Track Grid -->
                <ColumnDefinition Width="*"/>
                <!-- Column 2: Right Tag Editor Drawer -->
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#0C0F17" BorderBrush="#202738" BorderThickness="0,0,1,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="LIBRARY MANAGEMENT" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <Button Content="📁 Add Folder to Scan" Command="{Binding AddFolderCommand}" Height="34" Margin="0,0,0,6" Background="#141924" Foreground="#F8FAFC" BorderBrush="#202738"/>
                        <Button Content="🎵 Add Audio Files" Command="{Binding AddFilesCommand}" Height="34" Margin="0,0,0,6" Background="#141924" Foreground="#F8FAFC" BorderBrush="#202738"/>
                        <Button Content="📥 Import M3U8 Playlist" Command="{Binding ImportM3U8Command}" Height="34" Margin="0,0,0,6" Background="#141924" Foreground="#F8FAFC" BorderBrush="#202738"/>
                        <Button Content="📤 Export M3U8 Playlist" Command="{Binding ExportM3U8Command}" Height="34" Background="#141924" Foreground="#F8FAFC" BorderBrush="#202738"/>
                    </StackPanel>

                    <!-- Smart Filters / Playlist Info -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="LIBRARY STATS" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8"/>
                        <Border Background="#141924" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Tracks.Count, StringFormat={}{0} Total Tracks In Library}" FontSize="11" Foreground="#F59E0B" FontWeight="Bold"/>
                                <TextBlock Text="Bit-Exact WASAPI Stream Ready" FontSize="10" Foreground="#10B981" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CENTER TRACK GRID -->
            <Grid Grid.Column="1" Background="#05070A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search & Quick Filter -->
                <Border Grid.Row="0" Background="#0C0F17" Padding="12,8" BorderBrush="#202738" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="32" Padding="8,4" Background="#141924" Foreground="#F8FAFC" BorderBrush="#202738"
                                 d:Text="Search Artist, Album, Format..."/>
                        <TextBlock Grid.Column="0" Text="🔍 Search Title, Artist, Format..." Foreground="#475569" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchFilter}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- DataGrid Table -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredTracks}" 
                          SelectedItem="{Binding SelectedTrack}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#05070A" RowBackground="#05070A" AlternatingRowBackground="#0C0F17"
                          GridLinesVisibility="None" Foreground="#F8FAFC" HeadersVisibility="Column"
                          BorderThickness="0" Margin="0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0C0F17"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#202738"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="40"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1E293B"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#27272A"/>
                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!-- # Column -->
                        <DataGridTextColumn Header="#" Binding="{Binding TrackNumber}" Width="40"/>
                        <!-- Title -->
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/>
                        <!-- Artist -->
                        <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="1.5*"/>
                        <!-- Album -->
                        <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="1.5*"/>
                        <!-- Codec Format -->
                        <DataGridTextColumn Header="Audio Format" Binding="{Binding CodecFormat}" Width="1.8*"/>
                        <!-- Hi-Res Badge -->
                        <DataGridTemplateColumn Header="Quality" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding HiResBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#F59E0B"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Duration -->
                        <DataGridTextColumn Header="Time" Binding="{Binding DurationFormatted}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- RIGHT TAG EDITOR DRAWER -->
            <Border Grid.Column="2" Background="#0C0F17" BorderBrush="#202738" BorderThickness="1,0,0,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="METADATA &amp; COVER ART EDITOR" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,12"/>

                        <!-- Album Art Dropzone -->
                        <Border Height="180" Background="#141924" BorderBrush="#202738" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" AllowDrop="True">
                            <Grid>
                                <Image Source="{Binding EditingTag.CoverArtPreview}" Stretch="Uniform" Margin="4"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding EditingTag.CoverArtPreview, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="🖼️ Drag &amp; Drop Album Art" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <Button Content="Browse Cover..." Command="{Binding SelectCoverArtImageCommand}" Margin="0,8,0,0" Width="110" Height="26" Background="#1E293B" Foreground="#F8FAFC"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="TRACK DETAILS" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>

                        <!-- Title -->
                        <TextBlock Text="Title:" FontSize="10" Foreground="#94A3B8"/>
                        <TextBox Text="{Binding EditingTag.Title, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,8" Background="#141924" Foreground="#F8FAFC" BorderBrush="#202738"/>

                        <!-- Artist -->
                        <TextBlock Text="Artist:" FontSize="10" Foreground="#94A3B8"/>
                        <TextBox Text="{Binding EditingTag.Artist, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,8" Background="#141924" Foreground="#F8FAFC" BorderBrush="#202738"/>

                        <!-- Album -->
                        <TextBlock Text="Album:" FontSize="10" Foreground="#94A3B8"/>
                        <TextBox Text="{Binding EditingTag.Album, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,8" Background="#141924" Foreground="#F8FAFC" BorderBrush="#202738"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Year -->
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Year:" FontSize="10" Foreground="#94A3B8"/>
                                <TextBox Text="{Binding EditingTag.Year, UpdateSourceTrigger=PropertyChanged}" Height="28" Background="#141924" Foreground="#F8FAFC" BorderBrush="#202738"/>
                            </StackPanel>
                            <!-- Genre -->
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Genre:" FontSize="10" Foreground="#94A3B8"/>
                                <TextBox Text="{Binding EditingTag.Genre, UpdateSourceTrigger=PropertyChanged}" Height="28" Background="#141924" Foreground="#F8FAFC" BorderBrush="#202738"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Track # -->
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Track #:" FontSize="10" Foreground="#94A3B8"/>
                                <TextBox Text="{Binding EditingTag.TrackNumber, UpdateSourceTrigger=PropertyChanged}" Height="28" Background="#141924" Foreground="#F8FAFC" BorderBrush="#202738"/>
                            </StackPanel>
                            <!-- ReplayGain -->
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="ReplayGain (dB):" FontSize="10" Foreground="#94A3B8"/>
                                <TextBox Text="{Binding EditingTag.ReplayGainTrackGain, UpdateSourceTrigger=PropertyChanged}" Height="28" Background="#141924" Foreground="#F8FAFC" BorderBrush="#202738"/>
                            </StackPanel>
                        </Grid>

                        <!-- Lyrics -->
                        <TextBlock Text="Lyrics / Comments:" FontSize="10" Foreground="#94A3B8"/>
                        <TextBox Text="{Binding EditingTag.Lyrics, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,2,0,12" Background="#141924" Foreground="#F8FAFC" BorderBrush="#202738"/>

                        <!-- Save Metadata Button -->
                        <Button Content="💾 Write ID3 Tags &amp; Save" Command="{Binding SaveTagMetadataCommand}" 
                                Height="36" Background="#F59E0B" Foreground="#05070A" FontWeight="Bold" BorderThickness="0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ==================== ROW 4: BOTTOM PLAYBACK DOCK ==================== -->
        <Border Grid.Row="4" Background="#0C0F17" BorderBrush="#202738" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Current Track Info & Cover -->
                    <ColumnDefinition Width="280"/>
                    <!-- Center: Playback Controls & Seekbar -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Volume & Equalizer Toggles -->
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Current Track Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="4" Width="48" Height="48" Background="#141924" Margin="0,0,12,0">
                        <Image Source="{Binding CurrentTrack.CoverArt}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='Audiophile Reference Sweep'}" 
                                   FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" Width="200"/>
                        <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='Antigravity Sound Lab'}" 
                                   FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Width="200"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Controls & Seekbar -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <Button Content="⏮️" Command="{Binding PlayPreviousTrackCommand}" Width="36" Height="30" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" FontSize="14"/>
                        <Border CornerRadius="17" Background="#F59E0B" Width="40" Height="34" Margin="12,0">
                            <Button Command="{Binding PlayPauseCommand}" Background="Transparent" Foreground="#05070A" BorderThickness="0" FontSize="16" Width="40" Height="34">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="▶️"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Content" Value="⏸️"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        <Button Content="⏭️" Command="{Binding PlayNextTrackCommand}" Width="36" Height="30" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" FontSize="14"/>
                    </StackPanel>

                    <!-- Timeline Seek Bar -->
                    <Grid Width="500">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PositionFormatted}" FontSize="10" Foreground="#94A3B8" Margin="0,0,8,0"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="{Binding TotalDurationSeconds}" Value="{Binding CurrentPositionSeconds, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding DurationFormatted}" FontSize="10" Foreground="#94A3B8" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Volume & EQ Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🎚️ EQ" Command="{Binding ToggleEqualizerCommand}" Height="30" Padding="8,0" Margin="0,0,12,0" Background="#141924" Foreground="#F59E0B" BorderBrush="#202738"/>
                    <TextBlock Text="🔊" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider Width="100" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
